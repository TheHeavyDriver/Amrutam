{
  "name": "amrutam-telemedicine-backend",
  "version": "0.1.0",
  "description": "Production-grade telemedicine backend for Amrutam",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" vitest.config.ts",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" vitest.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run test",
    "test:cov": "vitest run --coverage",
    "db:migrate": "tsx src/database/cli.ts up",
    "db:rollback": "tsx src/database/cli.ts down",
    "db:status": "tsx src/database/cli.ts status",
    "db:seed": "tsx src/database/seed.ts",
    "db:migrate:prod": "node dist/database/cli.js up",
    "db:status:prod": "node dist/database/cli.js status",
    "api:validate": "redocly lint openapi/openapi.yaml --format=stylish",
    "api:generate": "oazapfts openapi/openapi.yaml clients/typescript/generated/api.ts --enumStyle=union --useUnknown",
    "api:typecheck": "tsc --noEmit -p clients/typescript/tsconfig.json",
    "api:check": "npm run api:validate && npm run api:typecheck",
    "prepare": "husky",
    "env:secrets": "node scripts/generate-dev-secrets.mjs"
  },
  "dependencies": {
    "@fastify/compress": "9.2.2",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "hash-wasm": "4.12.0",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@oazapfts/runtime": "1.2.0",
    "@redocly/cli": "2.71.1",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oazapfts": "7.5.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
