{
  "name": "amrutam-telemedicine-backend",
  "version": "0.1.0",
  "description": "Production-grade telemedicine backend for Amrutam",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" vitest.config.ts",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" vitest.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run test",
    "test:cov": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/compress": "9.2.2",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "fastify": "5.12.7",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
