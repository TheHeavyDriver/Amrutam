# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_VERSION=0.1.0

# HTTP
API_GLOBAL_PREFIX=api/v1
BODY_LIMIT_BYTES=1048576
TRUST_PROXY=true
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Logging
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Omit to auto-select: pretty in development, JSON elsewhere.
# LOG_PRETTY=true

# Data stores
# Host ports published by docker-compose (change if they clash locally).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Keep these in sync with the published ports above.
DATABASE_URL=postgresql://amrutam:amrutam@localhost:5432/amrutam
REDIS_URL=redis://localhost:6379
