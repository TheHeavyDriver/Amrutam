# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_VERSION=0.1.0

# HTTP
API_GLOBAL_PREFIX=api/v1
BODY_LIMIT_BYTES=1048576
TRUST_PROXY=true
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Logging
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Omit to auto-select: pretty in development, JSON elsewhere.
# LOG_PRETTY=true

# Data stores
# Host ports published by docker-compose (change if they clash locally).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Keep these in sync with the published ports above.
DATABASE_URL=postgresql://amrutam:amrutam@localhost:5432/amrutam
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
# Set to false only for isolated tests or emergency cache bypass.
CACHE_ENABLED=true

# Public URL used in links returned by the API.
APP_PUBLIC_URL=http://localhost:3000

# Authentication secrets. Generate independent random values, for example:
#   openssl rand -hex 48          (JWT_ACCESS_SECRET, JWT_MFA_SECRET, AUTH_TOKEN_PEPPER)
#   openssl rand -base64 32       (AUTH_ENCRYPTION_KEY, exactly 32 decoded bytes)
# The application refuses to start when any of these are missing or weak.
JWT_ACCESS_SECRET=
JWT_MFA_SECRET=
AUTH_TOKEN_PEPPER=
AUTH_ENCRYPTION_KEY=

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_MFA_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
# Production deployments should leave this true. Local development may set false
# to make newly registered accounts usable without an email provider.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# Global per-IP request limit. Authentication lockout is enforced separately.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
